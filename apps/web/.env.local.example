# Copy to .env.local and fill in from the Supabase dashboard
# (Project settings > API). Both values are safe to expose to the browser;
# row-level security in the database is what protects the data.
# Never put the service role key in this file or anywhere the browser can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only (no NEXT_PUBLIC_ prefix, so the browser never sees them).
# AI triage and letter drafts. Leave unset and the keyword fallback and templates are used.
ANTHROPIC_API_KEY=
# Inbound email (slice 4). The domain whose MX records point at Postmark, and a long random
# secret that Postmark sends with each webhook call (as ?secret=... on the webhook URL).
INBOUND_DOMAIN=
INBOUND_WEBHOOK_SECRET=
# The inbound webhook's server key: a long random value (32 characters or more, for example
# from `openssl rand -hex 32`). The database holds its hash and refuses inbound email without
# it, so only this server can write it. Set the same value in the database once, in the SQL editor:
#   select pd.set_server_key('inbound_email', '<this value>');
INBOUND_SERVER_KEY=

# Transactional email for the public form (slice 5): the verification link and the confirmation.
# Resend (https://resend.com): an API key and a verified sender. Leave both unset and, in
# development only, the links are printed to the server log and shown on the page.
RESEND_API_KEY=
EMAIL_FROM="Privacy Desk <requests@example.co.uk>"
# The site's own address (https://...), used in emailed links. Required in production: without it
# the public form refuses submissions rather than build a link from the request's host, which a
# sender can forge. In development it defaults to the request's host.
APP_URL=

# Nightly job (slice 6): reminders, bank holidays, retention. Call /api/jobs/nightly?secret=...
# once a night. The service role key sees every consultancy: server-side only, this route only.
SUPABASE_SERVICE_ROLE_KEY=
JOBS_SECRET=

# Production checklist (slice 7).
# Hours a signed-in session may sit idle before it is ended. Default 8.
SESSION_IDLE_HOURS=8
# The public form's server key: a long random value (32 characters or more, for example from
# `openssl rand -hex 32`). The database holds its hash and refuses form submissions without it,
# so only this server can write them. Set the same value in the database once, in the SQL editor:
#   select pd.set_server_key('public_form', '<this value>');
FORM_SERVER_KEY=
# Salt for the public form's per-address hourly cap (addresses are stored only as salted hashes).
FORM_RATE_SALT=
# Set to 1 to switch AI off for the whole deployment, whatever each client's switch says.
AI_DISABLED=

# Mailbox connection: lets a person choose emails from their own Microsoft 365 or Outlook.com
# inbox on the import page, and send a reply from a case. All three are safe to expose to the
# browser: the id only names the app registration, and no secret exists (the browser signs in
# with a one-time code, PKCE). The person's leave to use their mailbox stays in their browser
# and never reaches this server. Setting it up is in docs/NEXT-STEPS.md, section 16.
# The "Application (client) ID" of the app registration in Microsoft Entra. Leave empty and
# the mailbox buttons are not shown.
NEXT_PUBLIC_MS_CLIENT_ID=
# Optional. Empty or "common" accepts work and personal Microsoft accounts; a directory
# (tenant) id limits it to one organisation.
NEXT_PUBLIC_MS_TENANT=
# Development only, ignored in production: 1 shows a sample mailbox of made-up emails that
# sends nothing, so the screens can be tried before a real one is connected. Ignored when
# NEXT_PUBLIC_MS_CLIENT_ID is set.
NEXT_PUBLIC_MAILBOX_SAMPLE=
